# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# GitHub
GITHUB_TOKEN=ghp_your_github_token
GITHUB_USERNAME=your_github_username   # must match the token owner

# Repos to scan for bounty issues (comma-separated "owner/repo")
TARGET_REPOS=owner/repo1,owner/repo2

# Ethereum (for receiving bounty payments)
ETH_RPC_URL=https://sepolia.infura.io/v3/your_project_id
ETH_PRIVATE_KEY=your_private_key_hex

# Agent spending controls (used by agent.py payment mode)
APPROVAL_THRESHOLD_ETH=0.01
MAX_DAILY_SPEND_ETH=0.1

# Scan tuning
POLL_INTERVAL=300         # seconds between repo scans
MIN_BOUNTY_ETH=0.001      # ignore issues with a lower bounty
